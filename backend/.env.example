# ---------------------------------------------------------------
# Momentra Events – backend configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=momentra
DB_PASSWORD=change-me
DB_NAME=momentra_events

# JWT secret for admin login – use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Public base URL of this API (used to build uploaded image URLs). Optional.
PUBLIC_URL=http://localhost:5000
