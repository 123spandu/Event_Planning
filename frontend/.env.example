# ---------------------------------------------------------------
# Momentra Events – frontend configuration
# Copy to .env (or .env.local) and fill in real values.
# Every value here is public (bundled into the website).
# ---------------------------------------------------------------

# WhatsApp Business number in international format, digits only.
# Example format: 91XXXXXXXXXX  (91 = India country code)
VITE_WHATSAPP_NUMBER=

# Public business email shown on the Contact page
VITE_CONTACT_EMAIL=

# Full Instagram profile URL, e.g. https://www.instagram.com/yourhandle
VITE_INSTAGRAM_URL=

# Backend API base URL. Leave EMPTY to run the site without a backend:
# enquiries are then sent through WhatsApp and the admin dashboard is disabled.
# Local example: http://localhost:5000/api
VITE_API_URL=

# Public website URL (used for canonical / Open Graph tags)
VITE_SITE_URL=https://www.example.com
